    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "40.0 5.0 45\n",
      "Третья сторона -  36.635\n"
     ]
    }
   ],
   "source": [
    "a = float(input('Введите длину первой стороны'))\n",
    "b = float(input('Введите длину второй стороны'))\n",
    "ang = int(input('Введите угол между ними в градусах'))\n",
    "#print (a, b, ang)\n",
    "import math\n",
    "c = math.sqrt(a*a+b*b-2*a*b*math.cos(math.radians(ang)))\n",
    "print ('Третья сторона - ', round(c, 3))"
   ]
